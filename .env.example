# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
SECRET_KEY=troque-por-uma-chave-secreta
DEBUG=False

# ---------------------------------------------------------------------------
# Painel administrativo
# ---------------------------------------------------------------------------
# Token único que protege as rotas de escrita (cadastro, edição e disparo
# manual da sincronização). Não é um sistema de usuários: é um segredo
# compartilhado entre o painel e a API.
# Gere um com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem esta variável, com DEBUG=False, as rotas de escrita respondem 503.
ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# Google Sheets
# ---------------------------------------------------------------------------
# Id da planilha: o trecho entre /d/ e /edit na URL.
GOOGLE_SHEETS_ID=

# Credenciais da conta de serviço: escolha UMA das duas formas.
#
# (a) Secret File — recomendado no Render. Suba o JSON em Environment ->
#     Secret Files; o Render monta o arquivo em /etc/secrets/<nome>. Com o
#     nome google-credentials.json nem precisa declarar a variável abaixo,
#     que é só para apontar outro caminho.
GOOGLE_SERVICE_ACCOUNT_FILE=/etc/secrets/google-credentials.json
#
# (b) JSON inline — o conteúdo completo do arquivo numa variável só.
#     Se estiver preenchida, esta vence sobre o arquivo.
GOOGLE_SERVICE_ACCOUNT_JSON=
#
# Nas duas formas, a planilha precisa estar compartilhada como Editor com o
# client_email que está dentro do JSON.

# Nomes das abas. Criadas automaticamente se não existirem.
SHEETS_CADASTROS_TAB=Cadastros
SHEETS_MONITORAMENTO_TAB=Monitoramento

# Liga/desliga a integração por inteiro.
SHEETS_SYNC_ENABLED=True

# Hora local (0-23) a partir da qual o consolidado do dia é exportado.
SHEETS_EXPORT_HOUR=23

# ---------------------------------------------------------------------------
# Monitoramento
# ---------------------------------------------------------------------------
# Minutos sem requisição até a farmácia ser marcada como atrasada.
MONITOR_LATE_MINUTES=45
# Minutos sem requisição até ser marcada como sem comunicação.
MONITOR_OFFLINE_MINUTES=1440

# ---------------------------------------------------------------------------
# CORS (separar por vírgula)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=https://logs-view.netlify.app,http://localhost:3000
